{
    email {$CA_EMAIL}
}
{$DOMAIN} {
    encode
    request_body {
        max_size 50MB
    }
	handle /api/* {
		reverse_proxy {$BACKEND_URL} {  
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}